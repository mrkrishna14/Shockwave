# Local fixture mode only. Never expose this demo persona switcher publicly.
SHOCKWAVE_DEMO=1
SHOCKWAVE_DB=shockwave.db
SHOCKWAVE_ORIGIN=http://127.0.0.1:3000
SHOCKWAVE_SECURE_COOKIE=0
SHOCKWAVE_INLINE_JOBS=0
# Run scripts/start-worker.sh alongside the API when inline jobs are disabled.
# Override SHOCKWAVE_API_URL for the frontend proxy when testing another local port.
# Live integrations are intentionally unconfigured. No credentials are read by demo adapters.
# Invitation notification email (notice only; never contains an acceptance link).
# Leave SHOCKWAVE_SMTP_HOST empty to use the development inbox in demo mode.
SHOCKWAVE_SMTP_HOST=
SHOCKWAVE_SMTP_PORT=587
SHOCKWAVE_SMTP_USERNAME=
SHOCKWAVE_SMTP_PASSWORD=
SHOCKWAVE_SMTP_FROM=
SHOCKWAVE_SMTP_STARTTLS=1
SHOCKWAVE_APP_URL=http://127.0.0.1:3000
# Future owner adapters: GITHUB_APP_ID, GITHUB_PRIVATE_KEY_FILE,
# GITHUB_WEBHOOK_SECRET, RUNTIME_MODEL_API_KEY. Add only when integrating the actual adapters.
