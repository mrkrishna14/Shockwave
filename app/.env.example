# Local fixture mode only. Never expose this demo persona switcher publicly.
SHOCKWAVE_DEMO=1
SHOCKWAVE_DB=shockwave.db
SHOCKWAVE_ORIGIN=http://127.0.0.1:3000
SHOCKWAVE_SECURE_COOKIE=0
SHOCKWAVE_INLINE_JOBS=0
# Run scripts/start-worker.sh alongside the API when inline jobs are disabled.
# Override SHOCKWAVE_API_URL for the frontend proxy when testing another local port.
# Live integrations are intentionally unconfigured. No credentials are read by demo adapters.
# Future owner adapters: AUTH_ISSUER, AUTH_AUDIENCE, GITHUB_APP_ID,
# GITHUB_PRIVATE_KEY_FILE, GITHUB_WEBHOOK_SECRET, EMAIL_PROVIDER_API_KEY,
# RUNTIME_MODEL_API_KEY. Add only when integrating the actual adapters.
